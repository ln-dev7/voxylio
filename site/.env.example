# ── Neon Postgres (Console → project → Connect) ─────────────────────
# Pooled (-pooler hostname): the app's normal traffic.
DATABASE_URL="postgresql://…-pooler…/neondb?sslmode=require"
# Direct (no -pooler): used only by `pnpm db:migrate` / `db:push`.
DATABASE_URL_UNPOOLED="postgresql://…/neondb?sslmode=require"

# ── Neon Auth (Console → project → Auth → Configuration) ────────────
# The "Auth URL" shown under Project Info.
NEON_AUTH_BASE_URL="https://….neonauth.….neon.tech/neondb/auth"
# 32+ characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
# Google sign-in is configured in the Neon console (OAuth providers),
# not here. Add your own Google keys there before launch — the shared
# keys are for development only.

# ── Polar ───────────────────────────────────────────────────────────
# Organization access token (Settings → Developers).
POLAR_ACCESS_TOKEN=""
# Webhook endpoint: https://voxylio.lndev.me/api/webhooks/polar
# (format: Raw, event: customer.state_changed), secret below.
POLAR_WEBHOOK_SECRET=""
# 'sandbox' while testing, 'production' for real payments.
POLAR_SERVER="production"
# The Pro product ids (Products → … → copy id): monthly and yearly.
POLAR_PRODUCT_PRO_ID=""
POLAR_PRODUCT_PRO_YEARLY_ID=""

# ── Extension ───────────────────────────────────────────────────────
# The Chrome extension id (chrome://extensions, or the Web Store URL).
NEXT_PUBLIC_EXTENSION_ID="hahcpbcjfdanjncobfcdeidodfggggkp"

# ── Pro cloud features (docs/PRICING.md) ────────────────────────────
# Contextual translation provider — set ONE of these to activate the
# feature (entitlements report it off while all are empty). Priority:
# Gemini > DeepL > OpenAI.
# Gemini API key (Google AI Studio) — the chosen stack (docs/PRICING.md).
# (GEMINI_API_KEY also works as a fallback name.)
VOXYLIO_GEMINI_API_KEY=""
# Optional model override (default gemini-3.5-flash-lite).
PRO_GEMINI_MODEL=""
# Deepgram key — RESERVED for pillar 3 (no-subtitle dubbing). No code
# reads it yet; storing it here is harmless.
DEEPGRAM_ACCESS_TOKEN=""
# DeepL API key (Pro or free ':fx' key). Fast, purpose-built `context`.
PRO_DEEPL_KEY=""
# Or an OpenAI key (better register handling, higher latency).
OPENAI_API_KEY=""
# Optional model override for the OpenAI path (default gpt-4o-mini).
PRO_OPENAI_MODEL=""
# Monthly metered characters per Pro user (default 1500000).
PRO_MONTHLY_CHARS=""
# Deepgram key — RESERVED for pillar 3 (no-subtitle dubbing). No code
# reads it yet; safe to store now.
DEEPGRAM_API_KEY=""
