{
  "name": "voxylio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm --filter @voxylio/chrome build && pnpm --filter site build",
    "build:chrome": "pnpm --filter @voxylio/chrome build",
    "build:site": "pnpm --filter site build",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --test packages/core/test/*.test.js",
    "test:integration": "node tests/integration/run-all.js",
    "lint": "pnpm --filter site lint",
    "build:edge": "pnpm --filter @voxylio/edge build",
    "build:firefox": "pnpm --filter @voxylio/firefox build",
    "build:extensions": "pnpm build:chrome && pnpm build:edge && pnpm build:firefox",
    "lint:firefox": "pnpm --filter @voxylio/firefox lint",
    "release:chrome": "node scripts/release.mjs chrome",
    "release:edge": "node scripts/release.mjs edge",
    "release:firefox": "node scripts/release.mjs firefox",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "playwright": "^1.58.0"
  }
}
